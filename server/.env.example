# SkillBridge AI — Server Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
CLIENT_URL=http://localhost:5173

# ── Demo session ──────────────────────────────────────────────────────────────
DEMO_USER_NAME=Demo User
DEMO_USER_EMAIL=demo@skillbridge.ai

# ── IBM watsonx.ai (AI skill extraction) ─────────────────────────────────────
# Required for AI-powered skill extraction (Day 3+).
# If not set, the app falls back to deterministic keyword matching.
#
# Setup steps:
#   1. Create a free IBM Cloud account at https://cloud.ibm.com
#   2. Provision watsonx.ai Runtime — choose the Lite plan (free, 300,000 tokens/month)
#   3. Create a watsonx.ai Studio project — note the project_id from the Manage tab
#   4. Generate an IBM Cloud API key at https://cloud.ibm.com/iam/apikeys
#
# WATSONX_AI_AUTH_TYPE is set automatically by llmClient.js — do not add it here.

# Your IBM Cloud API key
WATSONX_AI_APIKEY=your_ibm_cloud_api_key_here

# watsonx.ai service URL for your IBM Cloud region:
#   Dallas (us-south):   https://us-south.ml.cloud.ibm.com
#   Frankfurt (eu-de):   https://eu-de.ml.cloud.ibm.com
#   London (eu-gb):      https://eu-gb.ml.cloud.ibm.com
#   Tokyo (jp-tok):      https://jp-tok.ml.cloud.ibm.com
WATSONX_AI_URL=https://us-south.ml.cloud.ibm.com

# Your watsonx.ai Studio project ID
WATSONX_AI_PROJECT_ID=your_project_id_here

# Foundation model to use.
# VERIFIED current multitenant models (as of November 2026):
#   ibm/granite-4-h-small  — Granite 4.0, 30B params, instruction-following
#                            Available in Dallas and Frankfurt regions.
#
# NOTE: granite-3-8b-instruct, granite-3-3-8b-instruct, granite-3-2-8b-instruct
#       were WITHDRAWN from multitenant on 22 February 2026.
#       Do NOT use those model IDs.
WATSONX_AI_MODEL=ibm/granite-4-h-small
